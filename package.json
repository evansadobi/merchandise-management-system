{
  "name": "mms-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/vendor-service",
    "services/procurement-service",
    "services/inventory-service",
    "services/receiving-service",
    "services/warehouse-service",
    "services/retail-sales-service",
    "services/sales-audit-service",
    "services/financials-service"
  ],
  "scripts": {
    "dev:vendor": "npm --prefix services/vendor-service run dev",
    "dev:procurement": "npm --prefix services/procurement-service run dev",
    "dev:inventory": "npm --prefix services/inventory-service run dev",
    "dev:receiving": "npm --prefix services/receiving-service run dev",
    "dev:retail-sales": "npm --prefix services/retail-sales-service run dev",
